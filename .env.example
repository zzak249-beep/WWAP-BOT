# ===== BingX (solo necesario si TRADE_MODE=live) =====
BINGX_API_KEY=
BINGX_API_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Modo =====
# signals = solo avisa por Telegram (RECOMENDADO al empezar)
# live    = además abre operaciones reales en BingX
TRADE_MODE=signals

# ===== Estrategia =====
TIMEFRAME=5m
HTF=15m
EMA_LEN=200
ATR_LEN=14
ATR_MULT=1.5
MIN_SL_PCT=0.50
MAX_SL_PCT=2.0
RR=2.0

# ===== Scanner =====
TOP_N=40
MIN_QUOTE_VOLUME=5000000
EXCLUDE_BASES=
MAX_SIGNALS_PER_SCAN=3
COOLDOWN_CANDLES=6

# ===== Riesgo =====
RISK_PCT=1.0
LEVERAGE=5
MARGIN_MODE=isolated
POSITION_MODE=hedge
MAX_OPEN=3
MAX_TRADES_DAY=6
DAILY_LOSS_PCT=3.0

# ===== Sesión (hora Nueva York) =====
USE_SESSION=true
SESSION_START=10:00
SESSION_END=17:00

LOG_LEVEL=INFO

# Incluir contratos TradFi de BingX (oro, acciones...). false = solo cripto
INCLUDE_TRADFI=false

# Tamaño igual por posición (tope = equity x apalancamiento / MAX_OPEN)
EQUAL_SIZE=true

# Gestión de ganancias
TRAIL=true
BE_R=1.0
BE_BUF_PCT=0.12
TRAIL_R=1.0
TRAIL_STEP_R=0.5
EXTEND_TP=true
EXTEND_R=1.0
MAX_EXTENSIONS=3
MANAGE_SEC=15

# ===== Filtros v4 (basados en investigación; verifícalos con backtest.py) =====
ADX_LEN=14
ADX_MIN=20
SLOPE_FILTER=true
SLOPE_BARS=12
MIN_REL_VOL=0.7
FEE_RT_PCT=0.10
SLIP_PCT=0.02
MAX_COST_RATIO=0.25
BTC_FILTER=true
BTC_MODE=soft
TIME_STOP_BARS=0
TIME_STOP_MIN_R=0.3

# VWAP: hora UTC en que se reinicia (0 = medianoche UTC) y velas a esperar tras el reinicio
VWAP_ANCHOR_HOUR=0
VWAP_MIN_BARS=36
