# ===== BingX (solo necesario si TRADE_MODE=live) =====
BINGX_API_KEY=
BINGX_API_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Modo =====
# signals = solo avisa por Telegram (RECOMENDADO al empezar)
# live    = además abre operaciones reales en BingX
TRADE_MODE=signals

# ===== Estrategia =====
TIMEFRAME=5m
HTF=15m
EMA_LEN=200
ATR_LEN=14
ATR_MULT=1.5
MIN_SL_PCT=0.30
MAX_SL_PCT=2.0
RR=2.0

# ===== Scanner =====
TOP_N=40
MIN_QUOTE_VOLUME=5000000
EXCLUDE_BASES=
MAX_SIGNALS_PER_SCAN=3
COOLDOWN_CANDLES=6

# ===== Riesgo =====
RISK_PCT=1.0
LEVERAGE=5
MARGIN_MODE=isolated
POSITION_MODE=hedge
MAX_OPEN=3
MAX_TRADES_DAY=6
DAILY_LOSS_PCT=3.0

# ===== Sesión (hora Nueva York) =====
USE_SESSION=true
SESSION_START=10:00
SESSION_END=17:00

LOG_LEVEL=INFO
